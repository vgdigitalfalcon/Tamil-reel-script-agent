# LLM API Keys (At least one is required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Provider: "gemini" | "anthropic" | "openai" | "simulation"
LLM_PROVIDER=gemini

# Model Names & Generation Hardening
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MAX_OUTPUT_TOKENS=3000
REGENERATION_MAX_OUTPUT_TOKENS=1000
LLM_TEMPERATURE=0.4

# Pricing & CRM Quota Guardrails (INR)
USD_TO_INR_RATE=85.0
FULL_SCRIPT_BUDGET_INR=0.50
REGENERATION_BUDGET_INR=0.15
QUOTA_RESERVATION_TTL_SECONDS=300
DAILY_USER_RUN_LIMIT=25
DUPLICATE_SUBMIT_WINDOW_SECONDS=30
LOW_BALANCE_WARNING_RATIO=0.20

# VG Digital Falcon CRM Persistence & Auth
# PostgreSQL DSN in production (e.g. postgresql://user:pass@host:5432/vg_crm)
# Leave blank for local SQLite fallback
DATABASE_URL=
CRM_JWT_SECRET=change-this-in-production
SUPABASE_JWT_SECRET=
CLIPFALCON_WEBHOOK_URL=

# Comma-separated browser origins allowed to call the API (CORS).
# Only needed if a frontend on another domain (e.g. Vercel) calls the API directly.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Docker / PHP gateway ---
# Password for the bundled Postgres container (docker-compose.yml)
POSTGRES_PASSWORD=change-me
# Set to "production" to disable the demo passcode login in the PHP gateway
CRM_ENV=development
SCRIPTFALCON_DEMO_PASSCODE=falcon-crm
# Production employee logins: JSON list of {email, password_hash (PHP password_hash), role, user_id, display_name}
SCRIPTFALCON_CRM_USERS_JSON=

# --- Production (docker-compose.prod.yml + Caddy HTTPS) ---
# Public hostname pointing at your server, e.g. scriptfalcon.duckdns.org
DOMAIN=
